viz('bridge', function () {
  // The 2027 NA EBITDA bridge, exactly as the model builds it.
  const steps = [
    { k: 'base', label: '2026\nguidance', v: {{bridge_0}}, kind: 'in' },
    { k: 'price', label: 'price that sticks\n{{stick}} of {{idx}}/t', v: {{bridge_1}}, kind: 'judg' },
    { k: 'vol', label: 'volume\n{{vol_signed}}', v: {{bridge_2}}, kind: 'judg' },
    { k: 'cost', label: '80/20\ncost-out', v: {{bridge_3}}, kind: 'judg' },
    { k: 'infl', label: 'inflation\nOCC, freight', v: {{bridge_4}}, kind: 'judg' },
    { k: 'end', label: '2027\nbridge', v: {{bridge_5}}, kind: 'total' },
    { k: 'mid', label: '2028\nmid-cycle {{na_margin}}', v: {{bridge_6}}, kind: 'total2' },
  ];
  const W = 680, H = 290, m = { t: 16, r: 16, b: 50, l: 54 };
  const el = document.getElementById('bridge');
  const svg = d3.select(el).insert('svg', ':first-child').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', '2027 NA EBITDA bridge');
  const x = d3.scaleBand().domain(steps.map(d => d.k)).range([m.l, W - m.r]).padding(0.3);
  const y = d3.scaleLinear().domain([2000, 3300]).range([H - m.b, m.t]);
  svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat(money).tickSize(-(W - m.l - m.r)))
    .call(g => { g.select('.domain').remove(); g.selectAll('line').attr('stroke', css('--rule')); g.selectAll('text').attr('fill', css('--ink-3')).attr('font-size', 10); });
  let run = 0;
  const color = d => d.kind === 'in' ? css('--ink-3') : d.kind === 'judg' ? (d.v >= 0 ? '#c86a2a' : '#b94a3c') : css('--accent');
  steps.forEach(d => {
    let y0, y1;
    if (d.kind === 'in' || d.kind === 'total' || d.kind === 'total2') { y0 = 2000; y1 = d.v; run = d.v; }
    else { y0 = run; y1 = run + d.v; run = y1; }
    svg.append('rect').attr('x', x(d.k)).attr('y', y(Math.max(y0, y1))).attr('width', x.bandwidth()).attr('height', Math.abs(y(y0) - y(y1))).attr('fill', color(d)).attr('rx', 2);
    svg.append('text').attr('x', x(d.k) + x.bandwidth() / 2).attr('y', y(Math.max(y0, y1)) - 5).attr('text-anchor', 'middle').attr('font-size', 11).attr('fill', css('--ink')).text((d.kind === 'judg' ? (d.v > 0 ? '+' : '') : '') + money(d.v));
    const lines = d.label.split('\n');
    lines.forEach((t, i) => svg.append('text').attr('x', x(d.k) + x.bandwidth() / 2).attr('y', H - m.b + 16 + i * 12).attr('text-anchor', 'middle').attr('font-size', 9.5).attr('fill', css('--ink-3')).text(t));
  });
  svg.append('line').attr('x1', x('end') + x.bandwidth()).attr('x2', x('mid')).attr('y1', y({{bridge_5}})).attr('y2', y({{bridge_6}})).attr('stroke', css('--ink-3')).attr('stroke-dasharray', '3 3');
  svg.append('text').attr('x', (x('end') + x.bandwidth() + x('mid')) / 2).attr('y', y({{bridge_mid}}) - 4).attr('text-anchor', 'middle').attr('font-size', 10).attr('fill', css('--ink-3')).text('the cyclical haircut');
});

viz('dist', function () {
  // Histogram of simulated value per share, with the price and the 10th/90th percentiles.
  const W = 680, H = 280, m = { t: 20, r: 16, b: 36, l: 44 };
