  const edges = MC.hist.edges, counts = MC.hist.counts, n = d3.sum(counts);
  const x = d3.scaleLinear().domain([0, 90]).range([m.l, W - m.r]);
  const y = d3.scaleLinear().domain([0, d3.max(counts) / n]).nice().range([H - m.b, m.t]);
  svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(9).tickFormat(d => '$' + d).tickSize(0))
    .call(g => { g.select('.domain').attr('stroke', css('--rule')); g.selectAll('text').attr('fill', css('--ink-3')).attr('font-size', 10).attr('dy', '1.2em'); });
  svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(d3.format('.0%')).tickSize(-(W - m.l - m.r)))
    .call(g => { g.select('.domain').remove(); g.selectAll('line').attr('stroke', css('--rule')); g.selectAll('text').attr('fill', css('--ink-3')).attr('font-size', 10); });
  svg.append('g').selectAll('rect').data(counts).join('rect')
    .attr('x', (d, i) => x(edges[i]) + 1).attr('width', (d, i) => Math.max(1, x(edges[i + 1]) - x(edges[i]) - 2))
