  rows.forEach(d => svg.append('text').attr('x', x(d.p_down) - (d.p_down >= 0.7 ? 6 : 0)).attr('y', y(d.p_above) - 9).attr('text-anchor', d.p_down >= 0.7 ? 'end' : 'middle').attr('font-size', 10).attr('fill', css('--ink')).text(d3.format('.0%')(d.p_above) + ' · ' + money(d.median)));
  const me = rows.find(d => Math.abs(d.p_down - MC.p_down) < 1e-6);
