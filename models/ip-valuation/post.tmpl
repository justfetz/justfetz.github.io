  svg.append('text').attr('x', x(MC.p_down) + 12).attr('y', y(me.p_above) + 18).attr('font-size', 10.5).attr('fill', '#c86a2a').text('my ' + d3.format('.0%')(MC.p_down));
  svg.append('text').attr('x', x(0.5)).attr('y', y(rows.find(d => Math.abs(d.p_down - 0.5) < 1e-6).p_above) + 20).attr('text-anchor', 'middle').attr('font-size', 10.5).attr('fill', css('--ink-2')).text("the market's price");
