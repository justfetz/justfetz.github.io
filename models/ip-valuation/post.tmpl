viz('bet', function () {
  // The same chain as the Scenarios sheet and montecarlo.py, in the browser, with the reader's beliefs.
  const I = {{json:calc}};
  const revNA26 = I.revH1 * 2 * I.revNA25 / (I.revNA25 + I.revEMEA25), revEMEA26 = I.revH1 * 2 * I.revEMEA25 / (I.revNA25 + I.revEMEA25), rev26 = revNA26 + revEMEA26;
  function value(a) { // a = {stick, margin, mult, wacc, vol, emeaMargin, emeaDelta, capexLT, noise}
    const pd = a.stick * I.idx * I.sens - I.inGuide;
    const revNA27 = revNA26 * (1 + a.vol) + pd, revEMEA27 = revEMEA26 * (1 + I.g), rev27 = revNA27 + revEMEA27;
    const na27 = I.na26 + pd + revNA26 * a.vol * I.contrib + (I.costout - I.infl) * revNA26 / rev26;
    const emea27 = I.emea26 + a.emeaDelta + (I.costout - I.infl) * revEMEA26 / rev26;
    const e27 = na27 + emea27 + I.corp, g3 = Math.pow(1 + I.g, 3), rev30 = rev27 * g3;
    const e30 = revNA27 * g3 * a.margin + revEMEA27 * g3 * a.emeaMargin + I.corp;
    const u30 = (e30 - rev30 * I.da) * (1 - I.tax) + rev30 * I.da - rev30 * a.capexLT - rev30 * I.g / (1 + I.g) * I.nwc;
    const u27 = (e27 - rev27 * I.da) * (1 - I.tax) + rev27 * I.da - I.capex27 - I.sep * 0.5;
    const w = a.wacc, D = t => Math.pow(1 + w, t);
    const pv = u27 / D(0.7) + (u27 * 2 / 3 + u30 / 3) / D(1.7) + (u27 / 3 + u30 * 2 / 3) / D(2.7) + u30 / D(3.7);
    const tv = 0.5 * (u30 * (1 + I.gT) / (w - I.gT) + e30 * a.mult) * a.noise;
    return { ps: (pv + tv / D(3.7) - I.netDebt) / I.shares, e27 };
  }
  // tiny seeded RNG + samplers, so the page is deterministic
  let seed = 2026; const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
  const tri = (a, m, b) => { const u = rnd(), c = (m - a) / (b - a); return u < c ? a + Math.sqrt(u * (b - a) * (m - a)) : b - Math.sqrt((1 - u) * (b - a) * (b - m)); };
  const norm = (mu, sd) => mu + sd * Math.sqrt(-2 * Math.log(rnd() + 1e-12)) * Math.cos(2 * Math.PI * rnd());
  const beta = (p, q) => { const x = -Math.log(rnd() + 1e-12) * p, y = -Math.log(rnd() + 1e-12) * q; return x / (x + y); }; // rough: gamma(k,1)≈exp*k shape proxy
  const $ = id => document.getElementById(id);
  const fmt = d3.format('$,.0f'), pct = d3.format('.0%');
  function run() {
    const stick = +$('bStick').value / 100, margin = +$('bMargin').value / 100, mult = +$('bMult').value, wacc = +$('bWacc').value / 100, pDown = +$('bDown').value / 100;
    $('vStick').textContent = pct(stick) + ' of $' + I.idx + '/t'; $('vMargin').textContent = (margin * 100).toFixed(1) + '%'; $('vMult').textContent = mult.toFixed(1) + '×'; $('vWacc').textContent = (wacc * 100).toFixed(1) + '%'; $('vDown').textContent = pct(pDown);
    const point = value({ stick, margin, mult, wacc, vol: I.vol, emeaMargin: I.emeaMargin, emeaDelta: I.emeaDelta, capexLT: I.capexLT, noise: 1 });
    // Monte Carlo around the reader's beliefs: base regime centered on their sliders, down-cycle regime pulled toward the bear.
    seed = 2026; const N = 3000, vals = [];
    for (let i = 0; i < N; i++) {
      const down = rnd() < pDown;
      const a = down
        ? { stick: Math.min(stick, beta(2, 5)), margin: tri(0.11, Math.min(margin, 0.135), 0.16), mult: tri(6, Math.min(mult, 7), 8.5), wacc: Math.min(0.10, Math.max(0.055, norm(wacc, 0.005))), vol: norm(-0.025, 0.015), emeaMargin: tri(0.08, 0.095, 0.11), emeaDelta: norm(0, 75), capexLT: tri(0.06, 0.065, 0.078), noise: Math.exp(norm(0, 0.15)) }
        : { stick: Math.max(0, Math.min(1, norm(stick, 0.12))), margin: tri(margin - 0.03, margin, margin + 0.035), mult: tri(mult - 1.5, mult, mult + 2.5), wacc: Math.min(0.10, Math.max(0.055, norm(wacc, 0.005))), vol: norm(0.01, 0.015), emeaMargin: tri(0.10, 0.115, 0.13), emeaDelta: norm(150, 75), capexLT: tri(0.06, 0.065, 0.078), noise: Math.exp(norm(0, 0.15)) };
      vals.push(value(a).ps);
    }
    vals.sort((x, y) => x - y);
    const p = vals.filter(v => v > I.price).length / N, q = k => vals[Math.floor(k * N)];
    $('oVal').textContent = fmt(point.ps); $('oUp').textContent = (point.ps / I.price - 1 >= 0 ? '+' : '') + pct(point.ps / I.price - 1);
    $('oP').textContent = pct(p); $('oPct').textContent = fmt(q(0.1)) + ' / ' + fmt(q(0.9)); $('oE').textContent = fmt(point.e27) + 'M';
    $('oVerdict').textContent = p > 0.6 ? `Under your beliefs the shares are worth more than ${fmt(I.price)} in ${pct(p)} of outcomes — an edge, if your ${pct(pDown)} on the cycle is right. The 10th percentile (${fmt(q(0.1))}) is the number to size against.`
      : p > 0.45 ? `Under your beliefs this is close to a fair bet (${pct(p)}). You're not being paid to take it; you'd be taking it for the dividend and the spin-off, which the model doesn't price.`
      : `Under your beliefs the market is right or generous at ${fmt(I.price)} (${pct(p)} above the price). The bull case needs a belief you don't hold.`;
    // histogram
    const svg = d3.select('#bHist'); svg.selectAll('*').remove();
    const W = 680, H = 120, m = { l: 8, r: 8, t: 8, b: 20 }, x = d3.scaleLinear().domain([0, 90]).range([m.l, W - m.r]);
    const bins = d3.bin().domain([0, 90]).thresholds(36)(vals), y = d3.scaleLinear().domain([0, d3.max(bins, b => b.length)]).range([H - m.b, m.t]);
    svg.append('g').selectAll('rect').data(bins).join('rect').attr('x', b => x(b.x0) + 1).attr('width', b => Math.max(1, x(b.x1) - x(b.x0) - 2)).attr('y', b => y(b.length)).attr('height', b => y(0) - y(b.length)).attr('fill', b => b.x1 <= I.price ? '#b94a3c' : css('--accent')).attr('opacity', 0.85);
    svg.append('line').attr('x1', x(I.price)).attr('x2', x(I.price)).attr('y1', m.t).attr('y2', H - m.b).attr('stroke', css('--ink')).attr('stroke-dasharray', '4 3');
    svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(9).tickFormat(d => '$' + d).tickSize(0)).call(g => { g.select('.domain').attr('stroke', css('--rule')); g.selectAll('text').attr('fill', css('--ink-3')).attr('font-size', 10).attr('dy', '1.2em'); });
  }
  ['bStick', 'bMargin', 'bMult', 'bWacc', 'bDown'].forEach(id => $(id).addEventListener('input', run));
  run();
});
</script>
</body>
</html>
