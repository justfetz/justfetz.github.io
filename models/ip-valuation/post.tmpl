  mark(MC.pct['90'], '90th pct ' + money(MC.pct['90']), '1 3', 44);   // below the legend lines on the right
  svg.append('text').attr('x', W - m.r).attr('y', m.t + 10).attr('text-anchor', 'end').attr('font-size', 11).attr('fill', css('--ink-2')).text(`P(value > price) = ${d3.format('.0%')(MC.p_above)}`);
  svg.append('text').attr('x', W - m.r).attr('y', m.t + 24).attr('text-anchor', 'end').attr('font-size', 10).attr('fill', css('--ink-3')).text('red: below the price · n = 20,000');
});

viz('cycle', function () {
